{
  "manifest_version": 3,
  "name": "ExpertBot — بوت التداول",
  "version": "2.0.0",
  "description": "بوت تداول آلي لـ Expert Option — يعمل داخل المتصفح بدون أي تحميل",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://app.expertoption.com/*",
    "https://*.expertoption.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://app.expertoption.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}

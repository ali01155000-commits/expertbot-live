// ExpertBot Live — Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivationCode {
  id          String    @id @default(cuid())
  code        String    @unique
  status      String    @default("active") // active | used | disabled
  createdById String?   // المسؤول الذي أنشأ الكود
  usedByToken String?   // توكن Expert Option للمستخدم الذي استخدم الكود
  usedByNote  String?   // ملاحظة (IP، جهاز، إلخ)
  createdAt   DateTime  @default(now())
  usedAt      DateTime?
  expiresAt   DateTime? // انتهاء صلاحية اختياري
  note        String?   // ملاحظة المسؤول

  @@index([code])
  @@index([status])
}

// ExpertBot Pro — automated trading bot simulator schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id            String      @id @default(cuid())
  email         String      @unique
  platformToken String
  accountType   String      @default("demo") // demo | real
  balance       Float       @default(10000)
  currency      String      @default("USD")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  trades        Trade[]
  botConfigs    BotConfig[]
}

model Trade {
  id         String   @id @default(cuid())
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  pair       String
  direction  String // CALL | PUT
  amount     Float
  entryPrice Float
  exitPrice  Float?
  expirySec  Int
  status     String   @default("open") // open | won | lost | tie
  payout     Float?
  profit     Float?
  openedAt   DateTime @default(now())
  closedAt   DateTime?
  source     String   @default("manual") // manual | bot
  strategy   String?

  @@index([accountId])
  @@index([status])
}

model BotConfig {
  id           String   @id @default(cuid())
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  strategy     String // ma_cross | rsi | trend | martingale
  pair         String
  amount       Float
  expirySec    Int
  martingale   Boolean  @default(false)
  mgMultiplier Float    @default(2)
  maxTrades    Int      @default(0) // 0 = unlimited
  active       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([accountId])
}

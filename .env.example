# ============================================================
# ExpertBot Live — Environment Variables (Production)
# ============================================================
# Copy this file to ".env" and fill in your values.
# On Hostinger VPS: place .env in the project root.

# --- Frontend (Next.js) ---
# The public URL of your deployed app (used by the browser extension + CORS).
NEXT_PUBLIC_APP_URL=https://your-domain.com

# The URL where the expert-service WebSocket is reachable.
# In production with Nginx, this is usually the SAME as NEXT_PUBLIC_APP_URL
# because Nginx proxies /socket.io/* to the expert-service.
# Leave EMPTY for the sandbox/dev (uses the Caddy gateway hack).
NEXT_PUBLIC_EXPERT_SERVICE_URL=https://your-domain.com

# --- Database (Prisma) ---
# SQLite file path (relative to project root). Auto-created on first run.
DATABASE_URL=file:./db/expertbot.db

# --- Expert Service (mini-services/expert-service) ---
# Port the expert-service listens on (internal, Nginx proxies to it).
EXPERT_SERVICE_PORT=3003
# Socket.io path. Use "/socket.io" in production (Nginx-proxied).
# Leave EMPTY for sandbox (defaults to "/" for Caddy).
SOCKET_PATH=/socket.io

# --- Node/Bun environment ---
NODE_ENV=production

# --- Browser Extension (OPTIONAL) ---
# Where users download the browser extension from.
# Default: served from the bot itself at /extension.zip (works out of the box).
# To host it separately (GitHub Releases, etc.), set this to the external URL:
#   NEXT_PUBLIC_EXTENSION_URL=https://github.com/USERNAME/REPO/releases/download/v1.0/expertbot-extension.zip
# Leave EMPTY to serve from the bot's /public/extension.zip
# NEXT_PUBLIC_EXTENSION_URL=
